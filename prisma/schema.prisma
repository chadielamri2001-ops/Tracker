generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum PaymentMethod {
  CASH
  TIKKIE
  POF
}

enum PriceKind {
  STANDARD
  MIX
}

enum SaleKind {
  NORMAL
  MULTI
  MIX
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Variant {
  id             String     @id @default(cuid())
  merk           String
  smaak          String
  voorraad       Int        @default(0)
  inkoopPrijs    Decimal    @default(0) @db.Decimal(12, 4)
  totaalVerkocht Int        @default(0)
  totaalOmzet    Decimal    @default(0) @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  purchases      Purchase[]
  saleItems      SaleItem[]

  @@unique([merk, smaak])
  @@index([merk])
}

model Purchase {
  id           String   @id @default(cuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  datum        DateTime @default(now())
  rollen       Int
  aantal       Int
  prijsPerRol  Decimal  @db.Decimal(12, 2)
  prijsPerStuk Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())

  @@index([datum])
  @@index([variantId])
}

model Sale {
  id           String        @id @default(cuid())
  kind         SaleKind      @default(NORMAL)
  datum        DateTime      @default(now())
  bedrag       Decimal       @db.Decimal(12, 2)
  basisBedrag  Decimal?      @db.Decimal(12, 2)
  bezorgkosten Decimal?      @db.Decimal(12, 2)
  rolAantal    Int?
  betaalwijze  PaymentMethod
  klantNaam    String?
  pofBetaald   Boolean       @default(false)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  items        SaleItem[]
  payments     Payment[]
  debt         Debt?

  @@index([datum])
  @@index([betaalwijze])
  @@index([kind])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  bedrag    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@index([method])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  aantal    Int
  bedrag    Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([variantId])
}

model Debt {
  id        String   @id @default(cuid())
  naam      String
  bedrag    Decimal  @db.Decimal(12, 2)
  betaald   Boolean  @default(false)
  datum     DateTime @default(now())
  paidAt    DateTime?
  saleId    String?  @unique
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([naam])
  @@index([betaald])
}

model Concept {
  id           String        @id @default(cuid())
  kind         SaleKind      @default(NORMAL)
  items        Json
  bedrag       Decimal       @db.Decimal(12, 2)
  basisBedrag  Decimal?      @db.Decimal(12, 2)
  bezorgkosten Decimal?      @db.Decimal(12, 2)
  rolAantal    Int?
  betaalwijze  PaymentMethod
  klantNaam    String?
  createdAt    DateTime      @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

model PriceConfig {
  key       String    @id
  kind      PriceKind
  quantity  Int?
  price     Decimal   @db.Decimal(12, 2)
  updatedAt DateTime  @updatedAt
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}
